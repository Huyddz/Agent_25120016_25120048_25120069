{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Build Ollama Client Test",
      "command": "g++",
      "args": [
        "-std=c++20",
        "-g",
        "src/main_test.cpp",
        "src/client/ollama_client.cpp",
        "-Isrc",
        "-Iinclude",
        "-lcurl",
        "-o",
        "${workspaceFolder}/bin/test_runner"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}